# scoopdope Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit your real `.env` file. Placeholder values below are safe defaults
# for local development only.
#
# SECURITY: No real secret values belong in this file. Every secret below is
# left empty (or set to an obvious placeholder) and MUST be supplied via the
# environment. The backend validates required secrets at startup and refuses to
# boot with a clear error if any are missing (see apps/backend/src/config).
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
=======

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Swagger / API docs (served at /api/docs)
# ---------------------------------------------------------------------------
# Swagger UI is disabled automatically when NODE_ENV=production. Set to `true`
# to explicitly enable it in production (not recommended unless the docs are
# protected). Local and staging environments serve Swagger regardless of this
# value.
SWAGGER_ENABLED=false
# When Swagger is enabled in production, /api/docs is protected with HTTP Basic
# Auth. The username is `admin` and this value is the password. Leave empty to
# keep the docs unreachable in production. Use a long, random value.
SWAGGER_PASSWORD=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Either provide a full connection string via DATABASE_URL, or the individual
# components below. DATABASE_URL takes precedence when set.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scoopdope
DATABASE_USERNAME=scoopdope
# REQUIRED secret. No default is provided; startup fails if unset.
DATABASE_PASSWORD=

# Connection pool tuning (see docs/environment-variables.md)
# Maximum number of connections in the pool. Raise for high-traffic deployments;
# keep well below the PostgreSQL server's max_connections limit.
DB_POOL_MAX=20
# Milliseconds to wait for a connection before failing with a timeout error.
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Redis (caching & session management)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional secret. Leave empty for a passwordless local Redis; required in
# production if your Redis instance enforces auth.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# REQUIRED secret. Must be a long, random string (>= 32 chars). Startup fails
# if unset or too short. Never reuse across environments.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Admin IP allowlist (#1390)
# Comma-separated list of IP addresses allowed to reach /admin routes, e.g.
#   ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.7
# This is a second layer on top of JWT/role checks: even a valid admin JWT is
# rejected with 403 when the request comes from an IP not listed here.
# Leave empty to block ALL admin access (no IPs are allowed). Non-admin routes
# are unaffected by this setting.
ADMIN_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Stellar network
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# REQUIRED secret for signing transactions. Never commit a real key.
STELLAR_SECRET_KEY=
# Public key corresponding to STELLAR_SECRET_KEY (safe to share).
STELLAR_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js) — must be prefixed with NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Public DSN for Sentry (safe to expose). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GIT_COMMIT_SHA=

# KYC
# REQUIRED secret when KYC is enabled.
KYC_PROVIDER_API_KEY=

# AWS (used for Comprehend content moderation)
AWS_REGION=us-east-1
# REQUIRED secrets when AWS-backed features are enabled. Prefer IAM roles in
# production instead of long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Content Moderation
MODERATION_TOXICITY_THRESHOLD=0.7

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Stripe (fiat payments)
# REQUIRED secrets when payments are enabled. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Non-secret price identifiers.
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Set to false to disable prorated subscription refunds (for promotional plans, for example).
STRIPE_SUBSCRIPTION_PRORATION_ENABLED=true

# Exchange Rate API (optional — omit to use free open.er-api.com)
# Get a key at https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Email / SMTP (transactional email)
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
# REQUIRED secret when email delivery is enabled.
EMAIL_PASS=
EMAIL_FROM=noreply@scoopdope.com

# OpenTelemetry (Tracing)
# Sampling rate for traces (0.0-1.0). Use 1.0 for development to sample all traces.
# In production, consider using 0.1 or lower to reduce trace volume and storage costs.
OTEL_SAMPLING_RATE=1.0

# Survey pseudonymization (#1241)
# Server-side secret used to HMAC survey userIds into deterministic pseudoIds for
# analytics exports. Must be a long random string and must NEVER be exposed to
# clients (do not prefix with NEXT_PUBLIC_). Rotating it changes all pseudoIds.
# REQUIRED secret. Startup fails if unset.
SURVEY_PSEUDONYMIZATION_SECRET=

# Web Push / VAPID (required for browser push notifications — #1019)
# Generate a new key pair once with:
#   node -e "const wp=require('web-push'); const keys=wp.generateVAPIDKeys(); console.log('Public:', keys.publicKey); console.log('Private:', keys.privateKey);"
# Then commit only the PUBLIC key to version control. Keep the PRIVATE key secret.
# REQUIRED secrets when web push is enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scoopdope.com

# ---------------------------------------------------------------------------
# Study groups
# ---------------------------------------------------------------------------
# Lifetime (in days) of study group invite links before they expire (#1150).
INVITE_LINK_TTL_DAYS=7
