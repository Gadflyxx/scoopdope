NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GIT_COMMIT_SHA=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Frontend environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit real
# secrets. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser and
# must never contain secret values.
# ---------------------------------------------------------------------------

# Base URL of the backend API (public, browser-accessible).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Stellar network the frontend targets: testnet | mainnet | futurenet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Sentry DSN for frontend error reporting (public DSN, safe to expose).
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Git commit SHA injected at build time (optional, informational).
NEXT_PUBLIC_GIT_COMMIT_SHA=

# Web Push VAPID public key used to subscribe browsers to push notifications.
# The matching private key must only be set server-side (see below).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Public site URL used for canonical links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Server-side secrets (never prefixed with NEXT_PUBLIC_, never exposed to the
# browser). Required only if the corresponding server-side feature is used.
# ---------------------------------------------------------------------------

# Sentry auth token for uploading source maps during builds (optional).
SENTRY_AUTH_TOKEN=

# Web Push VAPID private key. Must match NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=

# VAPID subject (mailto: or URL) identifying the push notification sender.
VAPID_SUBJECT=mailto:admin@example.com

# Secret used to sign/verify server-side session or auth cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
</｜｜DSML｜｜ parameter>
